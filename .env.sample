# Database settings
# The application talks to a REMOTE MySQL server, not the local db container.
# Copy this file to .env and fill in the real values -- .env is gitignored and
# is the only place credentials should live.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_DRIVER=pdo_mysql
DB_CHARSET=utf8mb4

# Other settings
