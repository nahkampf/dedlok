APP_NAME="Cyberpunk"
APP_ENV=local
APP_KEY=
# ^ leave blank on first run, then: docker compose exec web php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8088

# The game speaks English and only English; there is no locale to resolve.
# Laravel still needs these set — its own validation and auth messages come
# from vendor lang files keyed by them.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development: the `db` container, a copy of production made by bin/pull-db.
# On the live server these five name the real database instead.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cyberpunk_db
DB_USERNAME=cyberpunk_user
DB_PASSWORD='cyberpunk_password'

# Production, read by bin/pull-db and nothing else. The app never connects here.
# Real credentials -- .env is gitignored, keep it that way.
REMOTE_DB_HOST=
REMOTE_DB_PORT=3306
REMOTE_DB_DATABASE=
REMOTE_DB_USERNAME=
REMOTE_DB_PASSWORD=

# Sessions and cache stay on local disk deliberately. The database lives on a
# remote host over an unencrypted public link, so routing every session read
# and cache hit through it would be both slow and a privacy problem. Move these
# to redis (or database, once the link is TLS'd) before running more than one
# web node.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# TRUE BEHIND HTTPS, and it is not the same setting as php.ini's
# session.cookie_secure: Laravel writes its own session cookie from
# config/session.php, and the ini governs native PHP sessions the app does not
# use. Left empty here because the local stack is plain HTTP; set it on any
# deployment with a certificate, or the login cookie travels unprotected.
SESSION_SECURE_COOKIE=false
CACHE_STORE=file

# sync runs listeners in-process. Switch to database or redis when events start
# doing real work off the request path.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Cap -- self-hosted CAPTCHA on login, registration and password reset.
# See config/cap.php. Off by default so a fresh clone boots without it.
#
# CAP_ENDPOINT is the site-key URL from the Cap dashboard at :3010, WITH the
# trailing slash. CAP_SECRET is that site key's secret, not CAP_ADMIN_KEY.
# The browser talks to CAP_ENDPOINT directly, so it must be a URL the player
# can reach -- not the container name.
CAP_ENABLED=false
CAP_ENDPOINT=
CAP_SECRET=
CAP_ADMIN_KEY=
# Only when the web container cannot reach Cap at CAP_ENDPOINT -- which is the
# normal case with the bundled service, since the browser uses the published
# port and the container uses the service name:
#   CAP_ENDPOINT=http://localhost:3010/<site-key>/
#   CAP_VERIFY_ENDPOINT=http://cap:3000/<site-key>/
CAP_VERIFY_ENDPOINT=
# Defaults to the endpoint's own origin + /assets/widget.js.
CAP_WIDGET_SCRIPT=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@cyberpunk.local"
MAIL_FROM_NAME="${APP_NAME}"

# Feature flags (config/features.php; documented in CLAUDE.md). Off unless set.
# ALPHA TESTING: registration needs a beta key, and the admin gets a Beta keys section.
FEATURE_ALPHA_TESTING=false

# Ko-fi membership webhook (POST /kofi_webhook): the verification token from Ko-fi's API page. Unset, the receiver refuses everything.
KOFI_VERIFICATION_TOKEN=

# --- Websockets (Laravel Reverb): the chat page ---
# REVERB_HOST/PORT/SCHEME is where the APP publishes to (the `reverb` container); REVERB_PUBLIC_* is where the BROWSER connects.
REVERB_APP_ID=dedlok
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8085
REVERB_PUBLIC_SCHEME=http

# Verbose per-character diagnostic log (runs, scan passes, combat): one file a day, storage/logs/trace-YYYY-MM-DD.log.
# Comma separated handles; empty is off.
TRACE_HANDLES=
