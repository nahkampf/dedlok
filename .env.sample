APP_NAME="Cyberpunk"
APP_ENV=local
APP_KEY=
# ^ leave blank on first run, then: docker compose exec web php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8088

# The game speaks English and only English; there is no locale to resolve.
# Laravel still needs these set — its own validation and auth messages come
# from vendor lang files keyed by them.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Remote MySQL 8.0. Real credentials -- this file is gitignored, keep it that way.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions and cache stay on local disk deliberately. The database lives on a
# remote host over an unencrypted public link, so routing every session read
# and cache hit through it would be both slow and a privacy problem. Move these
# to redis (or database, once the link is TLS'd) before running more than one
# web node.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file

# sync runs listeners in-process. Switch to database or redis when events start
# doing real work off the request path.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Cap -- self-hosted CAPTCHA on login, registration and password reset.
# See config/cap.php. Off by default so a fresh clone boots without it.
#
# CAP_ENDPOINT is the site-key URL from the Cap dashboard at :3010, WITH the
# trailing slash. CAP_SECRET is that site key's secret, not CAP_ADMIN_KEY.
# The browser talks to CAP_ENDPOINT directly, so it must be a URL the player
# can reach -- not the container name.
CAP_ENABLED=false
CAP_ENDPOINT=
CAP_SECRET=
CAP_ADMIN_KEY=
# Only when the web container cannot reach Cap at CAP_ENDPOINT -- which is the
# normal case with the bundled service, since the browser uses the published
# port and the container uses the service name:
#   CAP_ENDPOINT=http://localhost:3010/<site-key>/
#   CAP_VERIFY_ENDPOINT=http://cap:3000/<site-key>/
CAP_VERIFY_ENDPOINT=
# Defaults to the endpoint's own origin + /assets/widget.js.
CAP_WIDGET_SCRIPT=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@cyberpunk.local"
MAIL_FROM_NAME="${APP_NAME}"
