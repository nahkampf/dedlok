#!/usr/bin/env bash
#
# Cut a release: put the work on a feature branch, draft the changelog from
# the commits, hand it to you to rewrite, then commit, merge and tag.
#
#   bin/release            # asks, showing the latest tag and what it suggests
#   bin/release 0.2.3      # or say so outright
#
# Work is done on main. Branching is this script's job, not yours: the commits
# since the last tag move onto a feature branch, main rewinds to the tag, and
# the release comes back as a --no-ff merge. The history reads as though the
# work had been branched all along, and nobody had to remember to branch.
#
# The name is asked for, with a suggestion read off the commits' own scopes —
# three feat(market) commits suggest feature/market.
#
# Rewinding main is only safe while the work is local, so the move is refused
# when any of those commits are already on origin/main; --no-branch releases in
# place instead. Run from a branch that is not main and nothing moves — that is
# the same release this script always cut.
#
# The draft is a starting point, not the entry. Commit subjects say what
# changed to someone reading the history; a changelog says what changed to
# someone deciding whether to pull. Those are different sentences, which is
# why this stops and opens an editor instead of committing what it generated.
#
# Nothing is committed until after you save. Quit the editor without removing
# the DRAFT marker and the script backs out, leaving the working tree — and the
# branches — as it found them.
#
# THEN THE PATCH NOTES. PATCHNOTES.md is the players' changelog, in plain
# words, and a release gets an entry there too: a `## X.Y.Z (YYYY-MM-DD)`
# heading is drafted from the changelog entry just written (or from
# --patchnotes), and nano opens on it. Same DRAFT marker, same backing out.
# Nano needs a terminal, so run this in one.
#
# Flags:
#   --branch NAME  name the feature branch instead of being asked for one
#   --no-branch    release in place, on whatever branch you are on
#   --no-tests     skip the suite (it is run in the web container when one is up)
#   --no-merge     commit and tag on the current branch, do not merge to main.
#                  Implies --no-branch: moving the work off main and then not
#                  merging it back would leave the release on a branch of its own.
#   --changelog FILE   use FILE as the finished changelog entry, headed
#                  `## [X.Y.Z] — YYYY-MM-DD`, instead of drafting one and opening
#                  an editor on it — for an entry written ahead of time.
#   --patchnotes FILE  start the patch notes from FILE (the body, no heading)
#                  rather than from the changelog entry. Nano still opens on it.
#
# PATCHNOTES_EDITOR overrides nano for the patch notes; EDITOR (default nano)
# is the changelog's.
#
set -euo pipefail

CHANGELOG="CHANGELOG.md"
PATCHNOTES="PATCHNOTES.md"
VERSION_FILE="config/version.php"
MAIN_BRANCH="main"
DRAFT_MARKER="<!-- DRAFT: rewrite the entries below, then delete this line. -->"

die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
note() { printf '\033[36m%s\033[0m\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*"; }

confirm() {
    local reply
    read -r -p "$1 [y/N] " reply
    [[ $reply == [yY] ]]
}

# ---- arguments -------------------------------------------------------------

VERSION=""
RUN_TESTS=1
DO_MERGE=1
DO_BRANCH=1
FEATURE=""
CHANGELOG_ENTRY=""
PATCHNOTES_ENTRY=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-tests) RUN_TESTS=0 ;;
        --no-merge) DO_MERGE=0; DO_BRANCH=0 ;;
        --no-branch) DO_BRANCH=0 ;;
        --branch) shift; [[ $# -gt 0 ]] || die "--branch needs a name"; FEATURE="$1" ;;
        --branch=*) FEATURE="${1#*=}" ;;
        --changelog) shift; [[ $# -gt 0 ]] || die "--changelog needs a file"; CHANGELOG_ENTRY="$1" ;;
        --patchnotes) shift; [[ $# -gt 0 ]] || die "--patchnotes needs a file"; PATCHNOTES_ENTRY="$1" ;;
        # The header block is the help text, so it cannot drift from the flags.
        -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) die "unknown flag: $1" ;;
        *) [[ -n $VERSION ]] && die "give exactly one version"; VERSION="$1" ;;
    esac
    shift
done

[[ -n $FEATURE && $DO_BRANCH == 0 ]] && die "--branch and --no-branch (or --no-merge) contradict each other"
[[ -z $CHANGELOG_ENTRY || -f $CHANGELOG_ENTRY ]] || die "no such file: $CHANGELOG_ENTRY"
[[ -z $PATCHNOTES_ENTRY || -f $PATCHNOTES_ENTRY ]] || die "no such file: $PATCHNOTES_ENTRY"

# ---- preflight -------------------------------------------------------------

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
cd "$(git rev-parse --show-toplevel)"

[[ -f $CHANGELOG ]] || die "no $CHANGELOG here"
[[ -f $VERSION_FILE ]] || die "no $VERSION_FILE here"

# The release commit must contain the changelog and the version bump and
# nothing else, so anything already modified has to be dealt with first.
[[ -z $(git status --porcelain) ]] || die "working tree is dirty — commit or stash first"

BRANCH=$(git branch --show-current)
[[ -n $BRANCH ]] || die "detached HEAD — check out a branch"

PREVIOUS=$(git describe --tags --abbrev=0 2>/dev/null || true)
if [[ -n $PREVIOUS ]]; then
    RANGE="$PREVIOUS..HEAD"
else
    RANGE="HEAD"
fi

COMMITS=$(git log --no-merges --pretty='%h%x09%s' "$RANGE")
[[ -n $COMMITS ]] || die "no commits since ${PREVIOUS:-the beginning} — nothing to release"

# Pre-1.0 the line is the schema: a release needing a migration is a minor,
# everything else is a patch. See CLAUDE.md, "Versioning and releases".
MIGRATIONS=$(git diff --name-only --diff-filter=A "$RANGE" -- database/migrations 2>/dev/null || true)

# ---- which version is this --------------------------------------------------

suggest() {   # the version this release looks like, by the project's own rule
    [[ -z $PREVIOUS ]] && { echo "0.1.0"; return; }

    local n=${PREVIOUS#v}
    local major=${n%%.*} rest=${n#*.} minor patch
    minor=${rest%%.*}
    patch=${rest#*.}

    if [[ -n $MIGRATIONS ]]; then
        echo "$major.$((minor + 1)).0"
    else
        echo "$major.$minor.$((patch + 1))"
    fi
}

if [[ -z $VERSION ]]; then
    [[ -t 0 ]] || die "usage: bin/release <version>   (or run it interactively)"

    SUGGESTED=$(suggest)
    printf '\n'
    note "Branch:     $BRANCH"
    note "Latest tag: ${PREVIOUS:-none yet}"
    note "Commits:    $(wc -l <<<"$COMMITS") since ${PREVIOUS:-the beginning}"

    if [[ -n $MIGRATIONS ]]; then
        note "Migrations: $(wc -l <<<"$MIGRATIONS") — a minor, by the schema rule"
        printf '  %s\n' $MIGRATIONS
    else
        note "Migrations: none — a patch, by the schema rule"
    fi

    printf '\n'
    while :; do
        read -r -p "Version for this release [$SUGGESTED]: " VERSION
        VERSION=${VERSION:-$SUGGESTED}

        [[ $VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
            || { warn "'$VERSION' is not a X.Y.Z version"; VERSION=""; continue; }

        git rev-parse -q --verify "refs/tags/v$VERSION" >/dev/null \
            && { warn "v$VERSION already exists"; VERSION=""; continue; }

        break
    done
fi

[[ $VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "'$VERSION' is not a X.Y.Z version"

TAG="v$VERSION"
git rev-parse -q --verify "refs/tags/$TAG" >/dev/null && die "$TAG already exists"

note "Releasing $TAG — changes since ${PREVIOUS:-the beginning} on '$BRANCH'."

# A version chosen against the rule is allowed, but not silently.
if [[ -n $PREVIOUS && -n $MIGRATIONS ]]; then
    PREV_NUM=${PREVIOUS#v}
    if [[ ${VERSION%.*} == "${PREV_NUM%.*}" ]]; then
        warn "this release adds migrations but only bumps the patch:"
        printf '  %s\n' $MIGRATIONS
        confirm "cut it as $VERSION anyway?" || die "aborted"
    fi
fi

# ---- what has to be put back if this does not finish ------------------------
#
# From here on the working tree and the branches both get moved, so any exit
# that is not a successful commit has to put them back — an editor that quits
# non-zero, a failed test run, a Ctrl-C. Nothing half-released is left behind.

DRAFT=$(mktemp)
MODIFIED=0
COMMITTED=0
MOVED=0
ORIGINAL_HEAD=""

cleanup() {
    rm -f "$DRAFT" "$CHANGELOG.tmp" "$PATCHNOTES.tmp"
    [[ $COMMITTED == 1 ]] && return 0

    if [[ $MODIFIED == 1 ]]; then
        git checkout -- "$CHANGELOG" "$VERSION_FILE" 2>/dev/null || true
        # A patch notes file this release created has nothing to go back to.
        if git ls-files --error-unmatch "$PATCHNOTES" >/dev/null 2>&1; then
            git checkout -- "$PATCHNOTES" 2>/dev/null || true
        else
            rm -f "$PATCHNOTES"
        fi
        warn "nothing was committed; working tree restored"
    fi

    if [[ $MOVED == 1 ]]; then
        # Main goes back over the work first, so checking it out afterwards
        # lands on the commit we are already standing on and the tree never
        # moves. Then the branch has nothing left in it to lose.
        git branch -f "$MAIN_BRANCH" "$ORIGINAL_HEAD" 2>/dev/null || true
        git checkout -q "$MAIN_BRANCH" 2>/dev/null || true
        git branch -D "$FEATURE" >/dev/null 2>&1 || true
        warn "the work is back on $MAIN_BRANCH; '$FEATURE' is gone"
    fi
}
trap cleanup EXIT INT TERM

# ---- the work moves to a feature branch -------------------------------------
#
# Work is done on main, so main is carrying commits that were never on a branch
# of their own. Rather than ask anyone to remember to branch first, the release
# does it after the fact: the commits since the tag become a branch, main
# rewinds to the tag, and the merge at the end brings them back. What lands in
# the history is what would have landed if the work had been branched all along.

suggest_branch() {   # a name from what the commits say they touched
    local scope slug subject

    # A commit scope is the closest thing the history has to a name for the
    # work. The commonest one wins; a tie goes to whichever sorts first, which
    # is arbitrary and never wrong enough to be worth asking about.
    scope=$(sed -E -n 's/^[^\t]*\t[a-z]+\(([^)]+)\).*/\1/p' <<<"$COMMITS" \
        | sort | uniq -c | sort -rn | head -1 | awk '{ print $2 }')

    if [[ -z $scope ]]; then
        # No scopes anywhere. Fall back to the words of the earliest feat, or
        # failing that the earliest commit of any kind: the one that started
        # the work usually says what the work was.
        subject=$(grep -P '\tfeat' <<<"$COMMITS" | tail -1 | cut -f2-)
        [[ -z $subject ]] && subject=$(tail -1 <<<"$COMMITS" | cut -f2-)
        scope=$(cut -d' ' -f1-3 <<<"${subject#*: }")
    fi

    slug=$(tr '[:upper:]' '[:lower:]' <<<"$scope" | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
    echo "feature/${slug:-work}"
}

usable_branch() {
    [[ -n $1 ]]                                        || { warn "a branch needs a name"; return 1; }
    [[ $1 != "$MAIN_BRANCH" ]]                         || { warn "that is $MAIN_BRANCH itself"; return 1; }
    git check-ref-format --branch "$1" >/dev/null 2>&1 || { warn "'$1' is not a usable branch name"; return 1; }
    ! git rev-parse -q --verify "refs/heads/$1" >/dev/null || { warn "branch '$1' already exists"; return 1; }
}

if [[ -n $FEATURE && $BRANCH != "$MAIN_BRANCH" ]]; then
    warn "already on '$BRANCH', so --branch $FEATURE has nothing to do"
fi

if [[ $DO_BRANCH == 1 && $BRANCH == "$MAIN_BRANCH" ]]; then
    UPSTREAM="refs/remotes/origin/$MAIN_BRANCH"
    PUSHED=0
    if [[ -n $PREVIOUS ]] && git rev-parse -q --verify "$UPSTREAM" >/dev/null; then
        PUSHED=$(git rev-list --count "$PREVIOUS..$UPSTREAM")
    fi

    if [[ -z $PREVIOUS ]]; then
        # There is no tag to rewind to: the work is the whole history, and a
        # main with nothing on it is not a base, it is an empty repository.
        warn "no tag yet, so there is nothing to rewind $MAIN_BRANCH to — releasing in place"
        DO_BRANCH=0
    elif [[ $PUSHED -gt 0 ]]; then
        warn "origin/$MAIN_BRANCH already carries $PUSHED of these commits, so moving them"
        warn "would need a force push. (This reads the last fetch; 'git fetch' if that is stale.)"
        die "release in place with --no-branch, or reset the remote yourself first"
    fi
fi

if [[ $DO_BRANCH == 1 && $BRANCH == "$MAIN_BRANCH" ]]; then
    if [[ -n $FEATURE ]]; then
        usable_branch "$FEATURE" || die "aborted"
    elif [[ -t 0 ]]; then
        SUGGESTED_BRANCH=$(suggest_branch)
        printf '\n'
        note "The work is on $MAIN_BRANCH. It moves onto a branch of its own and comes"
        note "back as a merge; $MAIN_BRANCH rewinds to $PREVIOUS in between."
        while :; do
            read -r -p "Feature branch name [$SUGGESTED_BRANCH]: " FEATURE
            FEATURE=${FEATURE:-$SUGGESTED_BRANCH}
            usable_branch "$FEATURE" && break
            FEATURE=""
        done
    else
        FEATURE=$(suggest_branch)
        usable_branch "$FEATURE" || die "name the branch with --branch NAME"
    fi

    ORIGINAL_HEAD=$(git rev-parse HEAD)

    # The checkout does not move the tree — the branch starts at the commit we
    # are already on — and main is rewound without being checked out, so no
    # file is written twice for the sake of a ref that moves.
    git checkout -q -b "$FEATURE"
    git branch -f "$MAIN_BRANCH" "$PREVIOUS"
    MOVED=1
    BRANCH="$FEATURE"

    note "Moved $(wc -l <<<"$COMMITS") commits onto '$FEATURE'; $MAIN_BRANCH is back at $PREVIOUS."
fi

# ---- draft -----------------------------------------------------------------

added=$(   grep -P '\t(feat)' <<<"$COMMITS" || true)
fixed=$(   grep -P '\t(fix)'  <<<"$COMMITS" || true)
changed=$( grep -Pv '\t(feat|fix)' <<<"$COMMITS" || true)

bullets() {   # hash<TAB>subject  ->  "- subject (hash)"
    [[ -z $1 ]] && return 0
    printf '%s\n' "$1" | awk -F'\t' '{ printf "- %s (%s)\n", $2, $1 }'
}

if [[ -n $CHANGELOG_ENTRY ]]; then
    grep -q "^## \[$VERSION\]" "$CHANGELOG_ENTRY" || die "$CHANGELOG_ENTRY has no '## [$VERSION]' heading"
    { cat "$CHANGELOG_ENTRY"; echo; } > "$DRAFT"
else
{
    echo "## [$VERSION] — $(date +%Y-%m-%d)"
    echo "$DRAFT_MARKER"
    for section in Added:"$added" Changed:"$changed" Fixed:"$fixed"; do
        body=${section#*:}
        [[ -z $body ]] && continue
        echo
        echo "### ${section%%:*}"
        echo
        bullets "$body"
    done
    if [[ -n $MIGRATIONS ]]; then
        echo
        echo "### Migrations"
        echo
        printf '%s\n' $MIGRATIONS | sed 's#database/migrations/#- `#; s#\.php$#`#'
    fi
    echo
} > "$DRAFT"
fi

# Slot it in under [Unreleased], which stays where it is and stays empty.
awk -v draft="$DRAFT" '
    { print }
    /^## \[Unreleased\]$/ && !done {
        print ""
        while ((getline line < draft) > 0) print line
        done = 1
    }
' "$CHANGELOG" > "$CHANGELOG.tmp" && mv "$CHANGELOG.tmp" "$CHANGELOG"

# Compare links, derived from the remote rather than hardcoded.
REMOTE=$(git remote get-url origin 2>/dev/null || true)
REPO=$(sed -E 's#^git@([^:]+):#https://\1/#; s#\.git$##' <<<"$REMOTE")

# Only if the remote is a URL. A clone from a local path has an origin that is
# a filesystem path, and a compare link built from one is worse than none.
if [[ $REPO == http* && -n $PREVIOUS ]]; then
    sed -i "s#^\[Unreleased\]: .*#[Unreleased]: $REPO/compare/$TAG...HEAD\n[$VERSION]: $REPO/compare/$PREVIOUS...$TAG#" "$CHANGELOG"
elif [[ -n $PREVIOUS ]]; then
    warn "origin is not an http remote; add the compare links by hand"
fi

sed -i -E "s/('app' => ')[0-9]+\.[0-9]+\.[0-9]+(')/\1$VERSION\2/" "$VERSION_FILE"
MODIFIED=1

grep -q "'$VERSION'" "$VERSION_FILE" || die "could not bump $VERSION_FILE — check its shape"

# ---- your turn -------------------------------------------------------------

if [[ -z $CHANGELOG_ENTRY ]]; then
    note "Opening $CHANGELOG. Rewrite the draft, delete the DRAFT line, save and quit."
    "${EDITOR:-nano}" "$CHANGELOG" || die "editor exited non-zero"
fi

grep -qF "$DRAFT_MARKER" "$CHANGELOG" && die "the DRAFT marker is still there"
grep -q "^## \[$VERSION\]" "$CHANGELOG" || die "no '## [$VERSION]' heading left in $CHANGELOG"

# ---- the players' version ----------------------------------------------------
#
# Drafted from the changelog entry as it now stands, minus what a player has no
# use for: the section headings and the Migrations list. Raw material for
# rewriting in plain words, never the entry itself — hence the marker.

{
    echo "## $VERSION ($(date +%Y-%m-%d))"
    echo "$DRAFT_MARKER"
    echo
    if [[ -n $PATCHNOTES_ENTRY ]]; then
        cat "$PATCHNOTES_ENTRY"
    else
        awk -v v="$VERSION" '
            index($0, "## [" v "]") == 1 { on = 1; next }
            on && /^## \[/ { exit }
            on && /^### Migrations/ { skip = 1; next }
            on && /^### / { skip = 0; next }
            on && !skip { print }
        ' "$CHANGELOG" | sed -e '/./,$!d'
    fi
    echo
} > "$DRAFT"

# On top, above the release before it; the file may not exist yet.
{ cat "$DRAFT"; [[ -f $PATCHNOTES ]] && cat "$PATCHNOTES"; } > "$PATCHNOTES.tmp"
mv "$PATCHNOTES.tmp" "$PATCHNOTES"

if [[ -z ${PATCHNOTES_EDITOR:-} ]]; then
    [[ -t 0 && -t 1 ]] || die "the patch notes open in nano, which needs a terminal — run this in one"
fi
note "Opening $PATCHNOTES. Write what changed for the players, delete the DRAFT line, save and quit."
"${PATCHNOTES_EDITOR:-nano}" "$PATCHNOTES" || die "editor exited non-zero"

grep -qF "$DRAFT_MARKER" "$PATCHNOTES" && die "the DRAFT marker is still in $PATCHNOTES"
grep -qE "^## ${VERSION//./[.]} \([0-9]{4}-[0-9]{2}-[0-9]{2}\):?[[:space:]]*$" "$PATCHNOTES" \
    || die "no '## $VERSION (YYYY-MM-DD)' heading left in $PATCHNOTES"

# ---- verify ----------------------------------------------------------------

if [[ $RUN_TESTS == 1 ]]; then
    if docker compose ps --status running --services 2>/dev/null | grep -qx web; then
        note "Running the suite..."
        docker compose exec -u www-data -T web php artisan test >/dev/null \
            || die "tests failed"
    else
        warn "web container is not running; skipping the suite"
    fi
fi

# ---- commit, merge, tag ----------------------------------------------------

git --no-pager diff --stat -- "$CHANGELOG" "$VERSION_FILE" "$PATCHNOTES"
confirm "Commit and tag $TAG?" || die "aborted"

git add "$CHANGELOG" "$VERSION_FILE" "$PATCHNOTES"
git commit -q -m "docs: release $VERSION"
COMMITTED=1

if [[ $DO_MERGE == 1 && $BRANCH != "$MAIN_BRANCH" ]]; then
    note "Merging '$BRANCH' into $MAIN_BRANCH..."
    git checkout -q "$MAIN_BRANCH"
    git merge --no-ff -q -m "Merge branch '$BRANCH' into $MAIN_BRANCH" "$BRANCH"
fi

# Tag wherever we ended up: on main after a merge, which is the point of
# merging first — a tag on a branch that later gets squashed points at a
# commit that no longer exists.
git tag -a "$TAG" -m "$VERSION"

if [[ $DO_MERGE == 1 && $BRANCH != "$MAIN_BRANCH" ]]; then
    if [[ $MOVED == 1 ]]; then
        # This script made the branch a minute ago and has just merged it. It
        # is a step in a release, not something anyone is working on, and
        # leaving it behind would collide with the next release's suggestion.
        git branch -d "$BRANCH" >/dev/null
        note "Merged and deleted '$BRANCH' — the merge commit is the record of it."
    elif confirm "Delete branch '$BRANCH'?"; then
        git branch -d "$BRANCH"
    fi
fi

note "$TAG is on $(git branch --show-current). Push it yourself when ready:"
echo "  git push origin $(git branch --show-current) --follow-tags"
